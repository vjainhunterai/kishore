"""
MySQL RDS → Excel Exporter (optimized for large datasets)
Streams rows from MySQL using a server-side cursor and writes them
to XLSX via openpyxl's write-only mode for low memory + fast export.
"""
import time
import pandas as pd
from sqlalchemy import create_engine, text
from openpyxl import Workbook
from openpyxl.cell import WriteOnlyCell
from openpyxl.styles import Font, PatternFill, Alignment
from openpyxl.utils import get_column_letter

# ============================================================
# CONFIGURATION — Edit these values
# ============================================================
DB_HOST = "prod-db.xxxxx.us-east-1.rds.amazonaws.com"
DB_PORT = 3306
DB_NAME = "contracts"
DB_USER = "user"
DB_PASS = "pass"
SSL_CA  = None  # e.g. "/path/to/rds-combined-ca-bundle.pem"

OUTPUT_FILE = "inmar_2021_data_v1.xlsx"
SHEET_NAME  = "QueryResult"
CHUNK_SIZE  = 50_000  # rows fetched per round-trip

# ============================================================
# SQL STATEMENT — Put your query here
# ============================================================
SQL = """
SELECT *
FROM l1_t0004_db.temp_ap_inv
WHERE CREATED_ON < '2022-01-01'
"""

# ============================================================
# EXPORT LOGIC
# ============================================================
def main():
    t0 = time.time()

    url = (
        f"mysql+pymysql://{DB_USER}:{DB_PASS}"
        f"@{DB_HOST}:{DB_PORT}/{DB_NAME}?charset=utf8mb4"
    )
    connect_args = {}
    if SSL_CA:
        connect_args["ssl"] = {"ca": SSL_CA}

    engine = create_engine(
        url,
        connect_args=connect_args,
        pool_pre_ping=True,
    )

    print(f"Connecting to {DB_HOST}:{DB_PORT}/{DB_NAME} ...")

    # Write-only workbook: streams rows directly to XLSX, low memory
    wb = Workbook(write_only=True)
    ws = wb.create_sheet(SHEET_NAME)

    header_font  = Font(bold=True, color="FFFFFF", name="Arial", size=11)
    header_fill  = PatternFill("solid", fgColor="4472C4")
    header_align = Alignment(horizontal="center", vertical="center")

    total_rows = 0
    columns = []

    with engine.connect().execution_options(
        stream_results=True,
        max_row_buffer=CHUNK_SIZE,
    ) as conn:
        print("Executing query (streaming) ...")
        result = conn.execute(text(SQL))

        # Header row
        columns = list(result.keys())
        header_cells = []
        for col_name in columns:
            c = WriteOnlyCell(ws, value=col_name)
            c.font = header_font
            c.fill = header_fill
            c.alignment = header_align
            header_cells.append(c)
        ws.append(header_cells)

        # Data rows — fetch in chunks from the server-side cursor
        while True:
            chunk = result.fetchmany(CHUNK_SIZE)
            if not chunk:
                break
            for row in chunk:
                ws.append(tuple(row))   # cast LegacyRow → tuple
            total_rows += len(chunk)
            print(f"  ... {total_rows:,} rows written  ({time.time()-t0:.1f}s)")

    if total_rows == 0:
        print("WARNING: Query returned 0 rows. Creating file with headers only.")

    # Column widths (header-based, fast)
    for idx, col_name in enumerate(columns, 1):
        width = min(max(len(str(col_name)) + 4, 14), 50)
        ws.column_dimensions[get_column_letter(idx)].width = width

    ws.freeze_panes = "A2"

    print(f"Saving workbook ({total_rows:,} rows) ...")
    wb.save(OUTPUT_FILE)
    print(f"Done in {time.time() - t0:.1f}s → {OUTPUT_FILE}")


if __name__ == "__main__":
    main()
