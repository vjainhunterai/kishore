"""
MySQL RDS → Excel Exporter (optimized for large datasets)
"""
import pandas as pd
from sqlalchemy import create_engine, text
from openpyxl import Workbook
from openpyxl.styles import Font, PatternFill, Alignment, NamedStyle
from openpyxl.utils import get_column_letter
from openpyxl.worksheet.table import Table, TableStyleInfo
import time

# ============================================================
# CONFIGURATION
# ============================================================
DB_HOST = "prod-db.xxxxx.us-east-1.rds.amazonaws.com"
DB_PORT = 3306
DB_NAME = "contracts"
DB_USER = "user"
DB_PASS = "pass"
SSL_CA = None

OUTPUT_FILE = "inmar_2021_data_v1.xlsx"
SHEET_NAME = "QueryResult"
CHUNK_SIZE = 50_000  # rows fetched per round-trip

SQL = """
SELECT * FROM l1_t0004_db.temp_ap_inv
WHERE CREATED_ON < '2022-01-01'
"""

# ============================================================
def main():
    t0 = time.time()
    
    url = (
        f"mysql+pymysql://{DB_USER}:{DB_PASS}@{DB_HOST}:{DB_PORT}/{DB_NAME}"
        f"?charset=utf8mb4"
    )
    connect_args = {}
    if SSL_CA:
        connect_args["ssl"] = {"ca": SSL_CA}

    # stream_results=True + server-side cursor avoids loading all rows in memory
    engine = create_engine(
        url,
        connect_args=connect_args,
        pool_pre_ping=True,
    )

    print(f"Connecting to {DB_HOST}:{DB_PORT}/{DB_NAME} ...")

    # write_only mode: dramatically faster, low memory, append rows as tuples
    wb = Workbook(write_only=True)
    ws = wb.create_sheet(SHEET_NAME)

    header_font = Font(bold=True, color="FFFFFF", name="Arial", size=11)
    header_fill = PatternFill("solid", fgColor="4472C4")
    header_align = Alignment(horizontal="center", vertical="center")

    headers_written = False
    total_rows = 0
    columns = []

    with engine.connect().execution_options(stream_results=True, max_row_buffer=CHUNK_SIZE) as conn:
        print("Executing query (streaming) ...")
        result = conn.execution_options(yield_per=CHUNK_SIZE).execute(text(SQL))

        for chunk in result.partitions(CHUNK_SIZE):
            if not headers_written:
                columns = list(result.keys())
                from openpyxl.cell import WriteOnlyCell
                header_cells = []
                for col_name in columns:
                    c = WriteOnlyCell(ws, value=col_name)
                    c.font = header_font
                    c.fill = header_fill
                    c.alignment = header_align
                    header_cells.append(c)
                ws.append(header_cells)
                headers_written = True

            for row in chunk:
                ws.append(row)
            total_rows += len(chunk)
            print(f"  ... {total_rows:,} rows written ({time.time()-t0:.1f}s)")

    # column widths — set once, no per-cell work
    for idx, col_name in enumerate(columns, 1):
        ws.column_dimensions[get_column_letter(idx)].width = min(max(len(str(col_name)) + 4, 14), 50)

    ws.freeze_panes = "A2"

    print(f"Saving workbook ({total_rows:,} rows) ...")
    wb.save(OUTPUT_FILE)
    print(f"Done in {time.time()-t0:.1f}s → {OUTPUT_FILE}")


if __name__ == "__main__":
    main()
