"""
MySQL RDS → Excel Exporter
Hardcoded SQL + connection config. Just edit and run.
"""

import pandas as pd
from sqlalchemy import create_engine, text
from openpyxl.styles import Font, PatternFill, Alignment, Border, Side
from datetime import datetime

# ============================================================
# CONFIGURATION — Edit these values
# ============================================================

DB_HOST = "prod-db.asnbcjdhjkhjkhjkhkjhjkjkjkjkjk.us-east-1.rds.amazonaws.com"
DB_PORT = 3306
DB_NAME = "contracts"
DB_USER = ""
DB_PASS = "!#!"
SSL_CA = None  # e.g. "/path/to/rds-combined-ca-bundle.pem"

OUTPUT_FILE = "inmar_2021_data_v1.xlsx"
SHEET_NAME = "QueryResult"

# ============================================================
# SQL STATEMENT — Put your query here
# ============================================================

SQL = """

SELECT * FROM l1_t0004_db.temp_ap_inv
where year(CREATED_ON) < 2022;
















    
          

"""

# ============================================================
# EXPORT LOGIC — No need to edit below
# ============================================================

def main():
    url = f"mysql+pymysql://{DB_USER}:{DB_PASS}@{DB_HOST}:{DB_PORT}/{DB_NAME}"
    connect_args = {}
    if SSL_CA:
        connect_args["ssl"] = {"ca": SSL_CA}

    engine = create_engine(url, connect_args=connect_args)

    print(f"Connecting to {DB_HOST}:{DB_PORT}/{DB_NAME} ...")
    with engine.connect() as conn:
        print("Executing query ...")
        df = pd.read_sql(text(SQL), conn)

    row_count = len(df)
    col_count = len(df.columns)
    print(f"Fetched {row_count} rows × {col_count} columns")

    if row_count == 0:
        print("WARNING: Query returned 0 rows. Creating file with headers only.")

    with pd.ExcelWriter(OUTPUT_FILE, engine="openpyxl") as writer:
        df.to_excel(writer, index=False, sheet_name=SHEET_NAME)
        ws = writer.sheets[SHEET_NAME]

        header_font = Font(bold=True, color="FFFFFF", name="Arial", size=11)
        header_fill = PatternFill("solid", fgColor="4472C4")
        header_align = Alignment(horizontal="center", vertical="center")
        thin_border = Border(bottom=Side(style="thin", color="B4C6E7"))

        for col_idx, col_name in enumerate(df.columns, 1):
            cell = ws.cell(row=1, column=col_idx)
            cell.font = header_font
            cell.fill = header_fill
            cell.alignment = header_align

        for col_idx, col_name in enumerate(df.columns, 1):
            max_len = max(
                len(str(col_name)),
                df[col_name].astype(str).str.len().max() if row_count > 0 else 0,
            )
            ws.column_dimensions[ws.cell(row=1, column=col_idx).column_letter].width = min(max_len + 4, 50)

        stripe_fill = PatternFill("solid", fgColor="D9E2F3")
        data_font = Font(name="Arial", size=10)
        for row_idx in range(2, row_count + 2):
            for col_idx in range(1, col_count + 1):
                cell = ws.cell(row=row_idx, column=col_idx)
                cell.font = data_font
                cell.border = thin_border
                if row_idx % 2 == 0:
                    cell.fill = stripe_fill

        ws.freeze_panes = "A2"
        ws.auto_filter.ref = ws.dimensions

    print(f"Exported to: {OUTPUT_FILE}")


if __name__ == "__main__":
    main()


