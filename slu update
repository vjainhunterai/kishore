SELECT DISTINCT SLU_FIELD7,
       CAST(CAST(SLU_FIELD7 AS DECIMAL(38,10)) AS SIGNED) AS new_val
FROM l3_dm_db.dim_slu
WHERE SLU_FIELD7 REGEXP '^-?[0-9]+(\\.[0-9]+)?$';


UPDATE l3_dm_db.dim_slu
SET SLU_FIELD7 = CAST(CAST(SLU_FIELD7 AS DECIMAL(38,10)) AS SIGNED)
WHERE SLU_FIELD7 REGEXP '^-?[0-9]+\\.0+$';
