-- ============================================================
-- THE DELETE (transactional)
-- ============================================================
START TRANSACTION;

DELETE FROM l1_t0004_db.temp_ap_inv       WHERE execution_id = '20260523109876';
SELECT ROW_COUNT() AS deleted_l1;

DELETE FROM l2_cdm_db.l2_invoice_detail   WHERE invhdrNameCustomer = 'BOSTON';
SELECT ROW_COUNT() AS deleted_l2;

DELETE FROM l3_dm_db.fact_invoice_details WHERE PARTY_GROUP_KEY = 6681;
SELECT ROW_COUNT() AS deleted_l3;

-- Verify counts are now 0, then:
COMMIT;
