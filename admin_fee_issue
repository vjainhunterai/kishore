CREATE TABLE admin_fee.MNP_Pool_PP_NS_1445_v1 AS
SELECT 
    mnp_id,
    mpn_normalized,
    description_text,
    manufacturer_raw,
    source_field,
    source_system,
    contract_no
FROM (
    SELECT DISTINCT
        m.id                AS mnp_id,
        m.mpn_normalized,
        m.description_text,
        m.manufacturer_raw,
        m.source_field,
        m.source_system,
        CASE 
            WHEN m.contract_no = 'PP-NS-1445' THEN m.contract_no
            ELSE m.contract_no
        END AS contract_no,
        ROW_NUMBER() OVER (
            PARTITION BY m.description_text
            ORDER BY 
                CASE WHEN m.contract_no = 'PP-NS-1445' THEN 0 ELSE 1 END ASC,
                LENGTH(m.mpn_normalized) DESC
        ) AS rn
    FROM admin_fee.mpn_staging_v2 m
    WHERE m.contract_no IN (
        SELECT Contract_Number
        FROM admin_fee.Contract_Group_PP_NS_1445_v1
    )
) deduped
WHERE rn = 1;
